# Copy this file to ".env" and fill in your EmailJS values (https://dashboard.emailjs.com)
# Then restart `npm run dev` / re-run `npm run build`.
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Public URL of the deployed site (with https://), used for the link-preview image
VITE_SITE_URL=https://your-domain.com/
